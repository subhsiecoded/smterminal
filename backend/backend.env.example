# Required - and that's it for market-data functionality. No Redis or local DB
# is needed to run quotes, candles, search, screeners, or the live ticker.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=

# Optional - genuine sub-second real-time overlay for US-listed symbols.
# Free signup at finnhub.io, no broker/KYC. Leave blank to run on Yahoo
# polling alone (fine, just not tick-level).
FINNHUB_API_KEY=

# Optional tuning
POLL_INTERVAL_SECONDS=3.0
QUOTE_CACHE_TTL_SECONDS=5
CANDLE_CACHE_TTL_SECONDS=30

# Optional - only needed if you re-enable login for orders/watchlists.
# SUPABASE_URL is the HTTPS project API URL used by supabase-py.
# DATABASE_URL below is the separate PostgreSQL connection string.
SUPABASE_URL=https://woguydtcnorgqtjaxbxr.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgresql://postgres.woguydtcnorgqtjaxbxr:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

LIVE_INTENT_TTL_SECONDS=300
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development

# Required only for a protected production Next.js deployment.
# Generate separate random values and set the same values in web/.env.local.
TERMINAL_BACKEND_TOKEN=
TERMINAL_WS_SECRET=
