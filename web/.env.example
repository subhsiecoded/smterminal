# Private backend origin; never prefix with NEXT_PUBLIC_.
MARKET_TERMINAL_API_BASE_URL=http://127.0.0.1:8000
MARKET_TERMINAL_WS_BASE_URL=ws://127.0.0.1:8000

# Shared password users enter on the website. Use a strong, unique value.
TERMINAL_ACCESS_PASSWORD=

# Generate independent random values for these secrets.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TERMINAL_SESSION_SECRET=
TERMINAL_BACKEND_TOKEN=
TERMINAL_WS_SECRET=
